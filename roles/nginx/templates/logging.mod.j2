{% macro server(sitename, nginxconf) %}
    access_log /var/log/nginx/{{ sitename }}_access.log prom;
    error_log /var/log/nginx/{{ sitename }}_error.log;

{%  if nginxconf.real_ip_from is defined %}
{%    for i in nginxconf.real_ip_from %}
        set_real_ip_from {{ i }};
{%    endfor %}
{%    if nginxconf.proxy_protocol | default(false) %}
        real_ip_header proxy_protocol;
{%    else %}
        real_ip_header X-Forwarded-For;
{%    endif %}
{%  endif %}
{% endmacro %}

{% macro location(sitename, locationname, nginxconf) %}
{%  if nginxconf.logsuffix | default(False) %}
     access_log /var/log/nginx/{{ sitename }}_{{ locationname | replace("/", "_") }}_access.log prom;
     error_log /var/log/nginx/{{ sitename }}_{{ locationname | replace("/", "_") }}_error.log;
{%  endif %}
{% endmacro %}
