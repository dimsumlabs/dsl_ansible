# Simply return
#
# nginx:
#   vhosts:
#     example.com:
#       template_type: generic
#       locations:
#         /:
#           location_type: return
#           return: 301 https://www.example.com$request_uri
#
# location / {
#   return 301 https://www.example.com$request_uri;
# }

{% macro render(config) %}
     add_header Cache-Control "public, max-age=604800, immutable";
     return {{ config.return }};
{% endmacro %}
